# MotoGo Box — start datového spojení v režimu RNDIS (AT$QCRMCALL=1,1) po bootu.
# Instaluje a zapíná `motogo-lte-mode rndis` (scripts/lte-mode.sh); `motogo-lte-mode qmi` ho vypne.
# V režimu QMI je zbytečný (data navazuje ModemManager) — install.sh ho proto neinstaluje.
[Unit]
Description=MotoGo Box - LTE data call (SIM7600 RNDIS)
After=network.target
Wants=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Modem se po bootu enumeruje se zpožděním; skript si AT port najde sám a start je idempotentní.
ExecStartPre=/bin/sleep 15
ExecStart=/usr/local/sbin/motogo-lte-rndis start
Restart=no

[Install]
WantedBy=multi-user.target
