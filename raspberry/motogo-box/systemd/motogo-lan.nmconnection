# MotoGo Box — LAN profil pro I/O síť (switch, Waveshare, Shelly). SPEC §4, HARDWARE.md §1.
# eth0 = JEN moduly: statická 192.168.50.10/24 + pomocná 192.168.1.253/24 (tovární síť Waveshare 192.168.1.254,
# io_provision.py). INTERNET JDE VÝHRADNĚ PŘES LTE (motogo-lte): eth0 nikdy nedává výchozí bránu ani DNS
# (`never-default`, `ignore-auto-*`, žádné `dns=`). Hybridní varianta s DHCP z routeru (2026-09-26) byla ZRUŠENA —
# na pobočkách router na kabelu není a trasa přes eth0 posílala internet do prázdna.
# Pojistka: NM dispatcher 50-motogo-lan-addr drží adresy a maže každou výchozí trasu přes eth0; health totéž (route_fix).
# Umístění: /etc/NetworkManager/system-connections/motogo-lan.nmconnection (chmod 600, root).
[connection]
id=motogo-lan
type=ethernet
interface-name=eth0
autoconnect=true
autoconnect-priority=20

[ethernet]

[ipv4]
method=manual
addresses=192.168.50.10/24,192.168.1.253/24
never-default=true
ignore-auto-dns=true
ignore-auto-routes=true

[ipv6]
method=ignore
addr-gen-mode=default

[proxy]
