# MotoGo Box — sudo bez hesla pro servisního uživatele "motogo" (jen vyjmenované příkazy).
# Instaluje install.sh do /etc/sudoers.d/motogo (chmod 440, ověřeno visudo -c).
# Skripty pod sudo jsou VÝHRADNĚ root-owned kopie v /usr/local/sbin (install.sh je tam
# instaluje z scripts/), aby je uživatel motogo nemohl přepsat a získat root.
# Argumenty jsou přibité: "" = příkaz smí běžet JEN bez argumentů. motogo-update by jinak přijal
# cizí zdrojový adresář a nainstaloval z něj sudoers/unity jako root; motogo-usbreset proto čte
# VID:PID z root-owned /etc/motogo/modem_vidpid; motogo-update bere cílový commit z
# /var/lib/motogo/update_ref (validace ^[0-9a-f]{7,40}$); motogo-sysupdate (apt full-upgrade)
# argumenty nemá vůbec — nikdy nerestartuje služby ani systém, restart OS dělá controller přes
# `systemctl reboot` (MOTOGO_POWER). Ostatní příkazy mají pevný argv (health.py je volá přesně
# takto: nmcli -w 30 con up …, mmcli --signal-setup=30, systemctl reboot).
# Používá: health monitor (nmcli, USB reset, reboot, mmcli signal-setup), vzdálené příkazy
# z Velína (reboot, update_software, update_system) a UI restart (systemctl restart motogo-*).
Defaults:motogo !requiretty
Defaults:motogo env_reset

Cmnd_Alias MOTOGO_POWER   = /usr/bin/systemctl reboot
Cmnd_Alias MOTOGO_SERVICE = /usr/bin/systemctl restart motogo-controller, /usr/bin/systemctl restart motogo-health, /usr/bin/systemctl restart motogo-ui, /usr/bin/systemctl restart motogo-controller motogo-health
Cmnd_Alias MOTOGO_SCRIPTS = /usr/local/sbin/motogo-usbreset "", /usr/local/sbin/motogo-update "", /usr/local/sbin/motogo-sysupdate ""
# Režim modemu QMI/RNDIS — jen tři pevné argumenty; skript je root-owned kopie scripts/lte-mode.sh (install/update).
Cmnd_Alias MOTOGO_LTEMODE = /usr/local/sbin/motogo-lte-mode rndis, /usr/local/sbin/motogo-lte-mode qmi, /usr/local/sbin/motogo-lte-mode status
Cmnd_Alias MOTOGO_LTE     = /usr/bin/nmcli -w 30 con up motogo-lte, /usr/bin/nmcli con up motogo-lte, /usr/bin/nmcli con down motogo-lte, /usr/bin/mmcli -m any --signal-setup=30, /usr/bin/mmcli -m any --reset
# I/O síť: health smí profil `motogo-lan` jen NAHODIT (žádné `con down` — to by shodilo funkční LAN
# a moduly by přestaly odpovídat). Argumenty jsou přibité včetně `-w 20` (health.LAN_UP_WAIT_S).
# Pomocná adresa tovární sítě Waveshare (192.168.1.254) — controller ji doplní sám (io_provision.py), protože
# aktualizaci z Velína provádí STARÁ kopie update.sh; pevná adresa i rozhraní, nic jiného nejde.
Cmnd_Alias MOTOGO_LAN     = /usr/bin/nmcli -w 20 con up motogo-lan, /usr/bin/nmcli con modify motogo-lan +ipv4.addresses 192.168.1.253/24, /usr/bin/nmcli device reapply eth0, /etc/NetworkManager/dispatcher.d/50-motogo-lan-addr eth0 manual

motogo ALL=(root) NOPASSWD: MOTOGO_POWER, MOTOGO_SERVICE, MOTOGO_SCRIPTS, MOTOGO_LTE, MOTOGO_LTEMODE, MOTOGO_LAN
