# MotoGo Box — NM profil pro modem v režimu RNDIS (SIM7600E-H, PID 9011).
# Nasazuje ho `motogo-lte-mode rndis` (scripts/lte-mode.sh) MÍSTO QMI profilu — pod stejným jménem
# `motogo-lte`: health, sudoers i servisní terminál na něj sahají pod tímhle jménem, takže se v režimu
# RNDIS nic dalšího nepřenastavuje. Původní QMI profil leží v /etc/motogo/motogo-lte.qmi.nmconnection.
# Modem je tu obyčejná síťová karta s DHCP serverem; datové spojení startuje AT$QCRMCALL=1,1
# (motogo-lte-rndis start, po bootu motogo-lte-rndis.service). Viz HARDWARE.md.
[connection]
id=motogo-lte
type=ethernet
interface-name=usb0
autoconnect=true
autoconnect-retries=0
autoconnect-priority=10

[ethernet]

[ipv4]
method=auto
# Výchozí trasa přes LTE má metriku 100 (hybridní motogo-lan s routerem na kabelu = 50, bez routeru žádná)
route-metric=100
may-fail=false
# záložní veřejné DNS (2026-09-26) k DNS operátora
dns=1.1.1.1;8.8.8.8;

[ipv6]
method=ignore
addr-gen-mode=default

[proxy]
