# ── Supabase (service role — NIKDY necommitovat skutečné hodnoty) ──────────────
# URL projektu MotoGo24, stejná jako používá Velín / edge funkce.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SERVICE ROLE key (ne anon!) — bot musí číst a zapisovat vouchers bez RLS omezení.
SUPABASE_SERVICE_ROLE_KEY=

# ── Slevomat partner portál ──────────────────────────────────────────────────
# Login má reCAPTCHA, takže se NEpřihlašuje automaticky heslem. Přihlas se
# jednorázově ručně přes `npm run login` (uloží se cookies session). Tyto
# proměnné se NEpoužívají — heslo nikam neukládej.

# ── Chování běhu ─────────────────────────────────────────────────────────────
# Jak často (v sekundách) watch režim hlídá DB na nové uplatněné poukazy.
POLL_INTERVAL_SEC=60
# Kolik poukazů zpracovat v jednom běhu (0 = bez limitu).
BATCH_LIMIT=0
# Prodleva mezi poukazy v ms (šetrné k portálu, snižuje riziko blokace).
DELAY_BETWEEN_MS=1500
# Kolikrát zkusit znovu poukaz, který skončil přechodnou chybou.
MAX_ATTEMPTS=3
# Spustit prohlížeč viditelně (1) nebo headless (0). Při ladění dej 1.
HEADFUL=0
# Port lokálního trigger serveru pro tlačítko ve Velínu (jen `npm run serve`).
TRIGGER_PORT=8787
