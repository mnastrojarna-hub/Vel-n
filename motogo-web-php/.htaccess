RewriteEngine On
RewriteBase /

# === 0. Let's Encrypt ACME HTTP-01 validation ===================================
# MUSI byt PRED vsemi redirecty. Bez teto vyjimky se Let's Encrypt validator
# (HTTP request na /.well-known/acme-challenge/<token>) presmeruje na HTTPS/www,
# coz pri prvnim vystaveni certu rozbije validaci (chicken-and-egg) -> validace
# selze a Hosting90 panel pak ukazuje SSL "Aktivni" lhářsky, zatimco server
# serviruje default cert h90-w22.hosting90.cz.
RewriteRule ^\.well-known/acme-challenge/ - [L]

# === 0b. IP kanonizace + neznáme/default hostname → primárního domeny ==========
# Seobility / SEO best practice: pristup primo pres IP adresu serveru
# (napr. http://185.129.138.219/) musi redirectovat na kanonickou doménu,
# jinak vznika "duplicate content" + Seobility hlasi "IP not redirected"
# a "page not mobile optimized" (testuje na IP variantě, ktera nema spravne
# vyrenderovany web).
#
# Match-y:
#   - HTTP_HOST je IPv4 (např. 185.129.138.219) → redirect
#   - HTTP_HOST je default hosting90 hostname (h90-w22.hosting90.cz) → redirect
#   - HTTP_HOST prazdny / neznamy → redirect
# Vse 301 na https://www.motogo24.cz/<orig path> (primarni domena).
RewriteCond %{HTTP_HOST} ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ [OR,NC]
RewriteCond %{HTTP_HOST} ^h\d+-w\d+\.hosting90\.cz$ [OR,NC]
RewriteCond %{HTTP_HOST} ^$
RewriteRule ^(.*)$ https://www.motogo24.cz/$1 [L,R=301]

# === 1. Force https://www. pro domeny na Hosting90 ==============================
# Hosting90 vystavuje Let's Encrypt cert jen na www. variantu (vhost ma
# www.motogo24.<tld> jako primarni jmeno). Hola domena bez www spada na default
# cert h90-w22.hosting90.cz -> "Nezabezpeceno" v prohlizeci. Presmerujeme proto
# holou domenu rovnou na https://www.<tld> (jeden redirect, aby browser ani na
# moment nesahnul na spatny cert). Musi byt PRED obecnym force-HTTPS nize.
# .cz je na Forpsi (jiny provider) - tam www resi proxy, .htaccess se ho netyka.
RewriteCond %{HTTP_HOST} ^motogo24\.(com|pl|at|es|fr|nl)$ [NC]
RewriteRule ^(.*)$ https://www.motogo24.%1/$1 [L,R=301]

# === 2. Force HTTPS pro zbytek (www. varianty + .cz) ===========================
# Dve podminky kvuli proxy: HTTPS=on i na portu 80 muze byt false-positive.
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

# === 3. Stare URL z puvodni verze webu (WordPress?) -> nove URL ==================
# Google ma tyto URL v indexu od predchozi verze. 301 redirecty zajisti
# transfer page-ranku a postupne nahrazeni v indexu (typicky 2-8 tydnu).
#
# SEO: VSECHNY redirecty jdou jednim hopem na finalni URL (zadne chainy
# typu /cz/X -> /X -> /jak-pujcit/Y). Google Search Console hlasi
# "Stranka s presmerovanim" pro kazdy hop v retezci a penalizuje crawl
# budget pri vice nez 1 hopu.

# === 3a. /cz/<deep-path> a /cs/<deep-path> — primy redirect na finalni URL ====
# (musi byt PRED genericky /cz/(.*) rewrite, jinak by se chytil ten)

# /cz/katalog-motorek/<id|kategorie> -> /katalog/<id|kategorie>
RewriteRule ^c[sz]/katalog-motorek/(cestovni|naked|supermoto|detske)/?$    /katalog/$1 [R=301,L]
# UUIDv4 (36 znaku s pomlckami) - aktualni format ID v Supabase, zachovavame
RewriteRule ^c[sz]/katalog-motorek/([a-f0-9]{8}-[a-f0-9\-]{27})/?$         /katalog/$1 [R=301,L]
# 13-znakovy hex slug (legacy timestamp ID, jiz neexistuje v DB) + cokoli jineho
# -> /katalog (listing). Preservovat ID nema smysl, motorka v DB neni.
RewriteRule ^c[sz]/katalog-motorek/?$                                      /katalog    [R=301,L]
RewriteRule ^c[sz]/katalog-motorek/.*$                                     /katalog    [R=301,L]

# /cz/jak-si-pujcit-motorku/<x> -> /jak-pujcit/<x>
RewriteRule ^c[sz]/jak-si-pujcit-motorku/vraceni-motocyklu-v-pujcovne/?$ /jak-pujcit/vraceni-pujcovna [R=301,L]
RewriteRule ^c[sz]/jak-si-pujcit-motorku/vraceni-motorky-jinde/?$        /jak-pujcit/vraceni-jinde    [R=301,L]
RewriteRule ^c[sz]/jak-si-pujcit-motorku/prevzeti-v-pujcovne/?$          /jak-pujcit/prevzeti         [R=301,L]
RewriteRule ^c[sz]/jak-si-pujcit-motorku/pristaveni-motocyklu/?$         /jak-pujcit/pristaveni       [R=301,L]
RewriteRule ^c[sz]/jak-si-pujcit-motorku/dokumenty-a-navody/?$           /jak-pujcit/dokumenty        [R=301,L]
RewriteRule ^c[sz]/jak-si-pujcit-motorku/casto-kladene-dotazy/?$         /jak-pujcit/faq              [R=301,L]
RewriteRule ^c[sz]/jak-si-pujcit-motorku/co-v-cene(?:-najmu)?/?$         /jak-pujcit/co-v-cene        [R=301,L]
RewriteRule ^c[sz]/jak-si-pujcit-motorku/postup/?$                       /jak-pujcit/postup           [R=301,L]
RewriteRule ^c[sz]/jak-si-pujcit-motorku/.*$                             /jak-pujcit/postup           [R=301,L]
RewriteRule ^c[sz]/jak-si-pujcit-motorku/?$                              /jak-pujcit/postup           [R=301,L]

# /cz/{legacy long-slug pages} -> primy cil
RewriteRule ^c[sz]/obchodni-podminky(?:-vop|/)?$         /dokumenty/obchodni-podminky           [R=301,L]
RewriteRule ^c[sz]/vseobecne-obchodni-podminky/?$        /dokumenty/obchodni-podminky           [R=301,L]
RewriteRule ^c[sz]/smlouva(?:-o-pronajmu)?/?$            /dokumenty/smlouva-o-pronajmu          [R=301,L]
RewriteRule ^c[sz]/gdpr/?$                               /dokumenty/zasady-ochrany-osobnich-udaju [R=301,L]
RewriteRule ^c[sz]/zasady-ochrany-osobnich-udaju/?$      /dokumenty/zasady-ochrany-osobnich-udaju [R=301,L]
RewriteRule ^c[sz]/blog(/.*)?$                           /blog$1                                 [R=301,L]
RewriteRule ^c[sz]/katalog(/.*)?$                        /katalog$1                              [R=301,L]

# Fallback: ostatni /cz|cs/<path> -> /<path>, /cz nebo /cs (bez slashe) -> /
RewriteRule ^c[sz]/(.*)$ /$1 [R=301,L]
RewriteRule ^c[sz]/?$    /   [R=301,L]

# === 3b. /katalog-motorek/<x> -> /katalog/<x> (preserves UUID/kategorii) =======
RewriteRule ^katalog-motorek/(cestovni|naked|supermoto|detske)/?$        /katalog/$1 [R=301,L]
# UUIDv4 (36 znaku s pomlckami) - zachovavame, motorka existuje v DB
RewriteRule ^katalog-motorek/([a-f0-9]{8}-[a-f0-9\-]{27})/?$             /katalog/$1 [R=301,L]
# 13-znakovy hex slug = legacy ID z WordPressu, motorka neni v Supabase
# -> /katalog (listing namisto 404)
RewriteRule ^katalog-motorek/.*$ /katalog [R=301,L]
RewriteRule ^katalog-motorek/?$  /katalog [R=301,L]

# === 3c. Kategorie motorek se starymi slugy (-motorky suffix) ==================
RewriteRule ^cestovni-motorky/?$  /katalog/cestovni  [R=301,L]
RewriteRule ^naked-motorky/?$     /katalog/naked     [R=301,L]
RewriteRule ^supermoto-motorky/?$ /katalog/supermoto [R=301,L]
RewriteRule ^detske-motorky/?$    /katalog/detske    [R=301,L]

# === 3d. "Jak si pujcit" - stare slugy ========================================
RewriteRule ^jak-si-pujcit-motorku/vraceni-motocyklu-v-pujcovne/?$ /jak-pujcit/vraceni-pujcovna [R=301,L]
RewriteRule ^jak-si-pujcit-motorku/vraceni-motorky-jinde/?$        /jak-pujcit/vraceni-jinde    [R=301,L]
RewriteRule ^jak-si-pujcit-motorku/prevzeti-v-pujcovne/?$          /jak-pujcit/prevzeti         [R=301,L]
RewriteRule ^jak-si-pujcit-motorku/pristaveni-motocyklu/?$         /jak-pujcit/pristaveni       [R=301,L]
RewriteRule ^jak-si-pujcit-motorku/dokumenty-a-navody/?$           /jak-pujcit/dokumenty        [R=301,L]
RewriteRule ^jak-si-pujcit-motorku/casto-kladene-dotazy/?$         /jak-pujcit/faq              [R=301,L]
RewriteRule ^jak-si-pujcit-motorku/co-v-cene(?:-najmu)?/?$         /jak-pujcit/co-v-cene        [R=301,L]
RewriteRule ^jak-si-pujcit-motorku/postup/?$                       /jak-pujcit/postup           [R=301,L]
# Catch-all -> /jak-pujcit/postup (rozcestnik /jak-pujcit se 301 redirektuje, byl
# by to chain; jdeme primo na finalni cil).
RewriteRule ^jak-si-pujcit-motorku/.*$ /jak-pujcit/postup [R=301,L]
RewriteRule ^jak-si-pujcit-motorku/?$  /jak-pujcit/postup [R=301,L]

# === 3e. Top-level stare slugy bez prefixu /jak-si-pujcit-motorku/ ============
RewriteRule ^postup-pujceni-motorky/?$           /jak-pujcit/postup           [R=301,L]
RewriteRule ^prevzeti-v-pujcovne/?$              /jak-pujcit/prevzeti         [R=301,L]
RewriteRule ^pristaveni-motocyklu/?$             /jak-pujcit/pristaveni       [R=301,L]
RewriteRule ^vraceni-motocyklu-v-pujcovne/?$     /jak-pujcit/vraceni-pujcovna [R=301,L]
RewriteRule ^vraceni-motorky-jinde/?$            /jak-pujcit/vraceni-jinde    [R=301,L]
RewriteRule ^dokumenty-a-navody/?$               /jak-pujcit/dokumenty        [R=301,L]
RewriteRule ^casto-kladene-dotazy/?$             /jak-pujcit/faq              [R=301,L]

# === 3f. Pravni stranky - PRIMY redirect na /dokumenty/<slug> (zadny chain) ===
# Drive: /smlouva-o-pronajmu -> /smlouva -> /dokumenty/smlouva-o-pronajmu (2 hopy).
# Search Console hlasi "Duplicitni stranka, Google zvolil jinou kanonickou stranku"
# pro /dokumenty/smlouva-o-pronajmu — pravdepodobne kvuli chained redirectu.
# Tady jdeme primo na finalni URL.
RewriteRule ^zasady-ochrany-osobnich-udaju/?$ /dokumenty/zasady-ochrany-osobnich-udaju [R=301,L]
RewriteRule ^obchodni-podminky-vop/?$         /dokumenty/obchodni-podminky             [R=301,L]
RewriteRule ^vseobecne-obchodni-podminky/?$   /dokumenty/obchodni-podminky             [R=301,L]
RewriteRule ^smlouva-o-pronajmu/?$            /dokumenty/smlouva-o-pronajmu            [R=301,L]
# Kratke aliasy /gdpr, /smlouva, /obchodni-podminky take primo (drive resil PHP):
RewriteRule ^gdpr/?$                          /dokumenty/zasady-ochrany-osobnich-udaju [R=301,L]
RewriteRule ^smlouva/?$                       /dokumenty/smlouva-o-pronajmu            [R=301,L]
RewriteRule ^obchodni-podminky/?$             /dokumenty/obchodni-podminky             [R=301,L]

# === 3g. Stare /images/<hash>/<size> z WordPressu -> 410 Gone =================
# Google ma v indexu URL typu /images/69ceb4590db43/large z drevni galerie.
# Tyto soubory nikdy existovat nebudou — 410 (misto 404) rekne Google
# "pryc navzdy" a urychli odstraneni z indexu.
RewriteRule ^images/[a-f0-9]+/(thumb|small|medium|large|orig|original)/?$ - [R=410,L]
RewriteRule ^images/[a-f0-9]+/?$ - [R=410,L]

# === 4. Stare prilohy /files/* (PDF z puvodniho WordPressu) =====================
# Tyto soubory uz na hostingu nejsou - vratit 410 Gone misto 404, aby Google
# rychleji odstranil z indexu (404 = doufa, ze se vrati; 410 = pryc navzdy).
RewriteRule ^files(/.*)?$ - [R=410,L]
RewriteRule ^wp-content(/.*)?$ - [R=410,L]
RewriteRule ^wp-admin(/.*)?$ - [R=410,L]
RewriteRule ^wp-includes(/.*)?$ - [R=410,L]
RewriteRule ^wp-login\.php$ - [R=410,L]

# === 5. Hezke URL pres index.php (catch-all) ===================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]

# === 6. Security headers (Lighthouse Best Practices) ============================
# Pridava security hlavicky bez nutnosti zasahu do PHP. mod_headers musi byt
# povoleny na hostingu (Hosting90 ano). Pokud by neslo, hlavicky lze duplikovat
# pres header() v index.php.
<IfModule mod_headers.c>
  # HSTS — vynuti HTTPS na 6 mesicu (po overeni navysit na 1 rok + preload).
  # includeSubDomains lze pridat pozdeji, az budou vsechny subdomeny na HTTPS.
  Header always set Strict-Transport-Security "max-age=15768000"

  # Clickjacking ochrana — embed jen z vlastni domeny.
  # CSP frame-ancestors je modernejsi nahrada za X-Frame-Options.
  Header always set Content-Security-Policy "frame-ancestors 'self'"
  Header always set X-Frame-Options "SAMEORIGIN"

  # Cross-Origin Opener Policy — izolace top-level oken (chrani pred
  # Spectre-like utoky a tabnabbing). same-origin-allow-popups pro Stripe
  # checkout popup; pokud Stripe Checkout neni potreba, lze zpritvridit na same-origin.
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"

  # MIME sniffing ochrana.
  Header always set X-Content-Type-Options "nosniff"

  # Referrer policy — standardni hodnota: na cross-origin posila jen origin
  # pres HTTPS, na HTTP nic.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions Policy — zakazane zbytecne API (geolocation pres feature flag,
  # ne globalne, takze povoleno; zbytek vypnuto).
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(self), payment=(self), interest-cohort=()"
</IfModule>

# === 7. Cache lifetimes (vykon: Lighthouse "Use efficient cache lifetimes") =====
<IfModule mod_expires.c>
  ExpiresActive On
  # Staticka aktiva s versionovanim v URL (assetUrl pridava ?v=...) — 1 rok, immutable
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/avif "access plus 6 months"
  ExpiresByType image/x-icon "access plus 6 months"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  # HTML zustava no-cache (dynamicky obsah z DB)
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # immutable cache hint pro statiku s ?v= versionovanim
  <FilesMatch "\.(css|js|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=15552000"
  </FilesMatch>
</IfModule>

# === 8. Gzip/Brotli komprese (vykon) ============================================
# Snizuje velikost prenosu o 60-80% pro textove zdroje (HTML/CSS/JS/SVG/JSON).
# mod_deflate je standardne dostupny na Hosting90; brotli (mod_brotli) volitelne.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE application/rss+xml application/atom+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  # Font soubory (woff/woff2 jsou uz komprimovane, ale font/* misetypy nekdy nekompresou)
  AddOutputFilterByType DEFLATE font/eot font/otf font/ttf
  # Vychytat broken IE6 a stary Netscape
  BrowserMatch ^Mozilla/4 gzip-only-text/html
  BrowserMatch ^Mozilla/4\.0[678] no-gzip
  BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
  Header append Vary User-Agent env=!dont-vary
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json application/xml
  AddOutputFilterByType BROTLI_COMPRESS application/rss+xml application/atom+xml
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>
